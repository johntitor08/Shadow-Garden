  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Level6_tr
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: tr
  m_SharedData: {fileID: 11400000, guid: 2e5d7b66d5f6be444b32a7a2c5b12f3e, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 953087889408
    m_Localized: "Nevoksa ana karakter.\nEn sonunda \xF6lecek.\nHepsi onun an\u0131lar\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 953926750208
    m_Localized: "Bence de do\u011Fru karar\u0131 verdin :D"
    m_Metadata:
      m_Items: []
  - m_Id: 952349691904
    m_Localized: "19 y\u0131ld\u0131z toplad\u0131ktan sonra gel."
    m_Metadata:
      m_Items: []
  - m_Id: 951544385536
    m_Localized: (Tavsiye etmiyorum ^^)
    m_Metadata:
      m_Items: []
  - m_Id: 950709719040
    m_Localized: Hikayenin sonunu bilmek ister misin?
    m_Metadata:
      m_Items: []
  - m_Id: 949833109504
    m_Localized: "Buray\u0131 buldu\u011Funa inanam\u0131yorum.\r\nSana bir hak verece\u011Fim."
    m_Metadata:
      m_Items: []
  - m_Id: 949061357568
    m_Localized: "Sadece h\u0131z modu"
    m_Metadata:
      m_Items: []
  - m_Id: 948222496768
    m_Localized: Sadece zorluk modu
    m_Metadata:
      m_Items: []
  - m_Id: 947861786624
    m_Localized: Gerek yok.
    m_Metadata:
      m_Items: []
  - m_Id: 946595106816
    m_Localized: "\xC7ok iyi fikir."
    m_Metadata:
      m_Items: []
  - m_Id: 945785606144
    m_Localized: "Daha k\u0131sa"
    m_Metadata:
      m_Items: []
  - m_Id: 945001271296
    m_Localized: "Ayn\u0131 kals\u0131n"
    m_Metadata:
      m_Items: []
  - m_Id: 944204353536
    m_Localized: Daha uzun
    m_Metadata:
      m_Items: []
  - m_Id: 943403241472
    m_Localized: "Parkur tarz\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 942597935104
    m_Localized: "Aksiyon ve d\xFC\u015Fman tarz\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 941826183168
    m_Localized: "Bulmaca ve labirent tarz\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 941087985664
    m_Localized: "Ba\u015Fka..."
    m_Metadata:
      m_Items: []
  - m_Id: 940312039424
    m_Localized: Daha kolay oyun
    m_Metadata:
      m_Items: []
  - m_Id: 939510927360
    m_Localized: "Ak\u0131c\u0131l\u0131k"
    m_Metadata:
      m_Items: []
  - m_Id: 938835644416
    m_Localized: Kalite
    m_Metadata:
      m_Items: []
  - m_Id: 938034532352
    m_Localized: "\u0130lerleyi\u015Fini merak ediyorum."
    m_Metadata:
      m_Items: []
  - m_Id: 937229225984
    m_Localized: Daha iyi olabilirdi.
    m_Metadata:
      m_Items: []
  - m_Id: 935614418944
    m_Localized: "Be\u011Fendim gibi."
    m_Metadata:
      m_Items: []
  - m_Id: 32668848128
    m_Localized: "\u0130lgi \xE7ekici"
    m_Metadata:
      m_Items: []
  - m_Id: 31930650624
    m_Localized: "S\u0131k\u0131c\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 31158898688
    m_Localized: "E\u011Flenceli"
    m_Metadata:
      m_Items: []
  - m_Id: 30454255616
    m_Localized: "Hay\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 29753806848
    m_Localized: Neden?
    m_Metadata:
      m_Items: []
  - m_Id: 29057552384
    m_Localized: Evet
    m_Metadata:
      m_Items: []
  - m_Id: 28172554240
    m_Localized: "Hikaye hakk\u0131nda ne d\xFC\u015F\xFCn\xFCyorsun?"
    m_Metadata:
      m_Items: []
  - m_Id: 27472105472
    m_Localized: "Oyunu 10 \xFCzerinden puanlayabilir misin?"
    m_Metadata:
      m_Items: []
  - m_Id: 26700353536
    m_Localized: "\u015Eu \u015Fekilde olmal\u0131:"
    m_Metadata:
      m_Items: []
  - m_Id: 26096373760
    m_Localized: "Ne tarz seviyelerden ho\u015Flan\u0131rs\u0131n?"
    m_Metadata:
      m_Items: []
  - m_Id: 25353981952
    m_Localized: "Hay\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 24619978752
    m_Localized: Evet
    m_Metadata:
      m_Items: []
  - m_Id: 23881781248
    m_Localized: "Geri bildirimlerin i\xE7in te\u015Fekk\xFCrler :)"
    m_Metadata:
      m_Items: []
  - m_Id: 23143583744
    m_Localized: "Seviyelerde zorluk modu veya h\u0131z modu ister misin?"
    m_Metadata:
      m_Items: []
  - m_Id: 22396997632
    m_Localized: "Seviye uzunluklar\u0131 hakk\u0131nda ne d\xFC\u015F\xFCn\xFCyorsun?"
    m_Metadata:
      m_Items: []
  - m_Id: 21499416576
    m_Localized: "Oyunu istedi\u011Fin gibi \u015Fekillendirmeye \xE7al\u0131\u015Faca\u011F\u0131m."
    m_Metadata:
      m_Items: []
  - m_Id: 18747953152
    m_Localized: Oyundan ne bekliyorsun?
    m_Metadata:
      m_Items: []
  - m_Id: 15757414400
    m_Localized: "\xC7\xFCnk\xFC oyunu be\u011Fenip be\u011Fenmedi\u011Fini merak
      ediyorum."
    m_Metadata:
      m_Items: []
  - m_Id: 7779848192
    m_Localized: "\u0130lerlemek istiyor musun?"
    m_Metadata:
      m_Items: []
  - m_Id: 13618319360
    m_Localized: "Tamam, memnun kald\u0131ysan ne mutlu."
    m_Metadata:
      m_Items: []
  - m_Id: 10887827456
    m_Localized: Emin misin?
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []

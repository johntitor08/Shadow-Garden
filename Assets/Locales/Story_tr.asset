  m_TableData:
  - m_Id: 12989173760
    m_Localized: "Bir g\xFCn bu diyarlarda bir ninja ya\u015Farm\u0131\u015F. En
      b\xFCy\xFCk hayali avatar olmakm\u0131\u015F."
    m_Metadata:
      m_Items: []
  - m_Id: 1756857953095680
    m_Localized: "Ustas\u0131 ona ejder topundan bahsetmi\u015F. Ejder topunu elde
      eden ki\u015Fi 4 elementte ustala\u015F\u0131rm\u0131\u015F."
    m_Metadata:
      m_Items: []
  - m_Id: 1757440957157376
    m_Localized: "Ustas\u0131 ona \u015F\xF6yle demi\u015F: \"Avatar olman\u0131n
      tek yolu ejder topuna sahip olmakt\u0131r.\""
    m_Metadata:
      m_Items: []
  - m_Id: 1757444224520192
    m_Localized: "Bu ninja ejder topunu bulmaya karar vermi\u015F ve maceraya at\u0131lm\u0131\u015F."
    m_Metadata:
      m_Items: []
  - m_Id: 1758137907875840
    m_Localized: "Dilini Se\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 1758624371642368
    m_Localized: Onayla
    m_Metadata:
      m_Items: []
  - m_Id: 1758796203888640
    m_Localized: "Sahneyi Ge\xE7 -->"
    m_Metadata:
      m_Items: []
  - m_Id: 1758789832740864
    m_Localized: "Hikayeyi Ge\xE7 -->"

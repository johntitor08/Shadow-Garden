    m_Metadata:
      m_Items: []
  - m_Id: 191406477312
    m_Localized: "D\xFCnyaya h\xFCkmedece\u011Fim!"
    m_Metadata:
      m_Items: []
  - m_Id: 189829419008
    m_Localized: Neredeyim?
    m_Metadata:
      m_Items: []
  - m_Id: 212763799916544
    m_Localized: "Hey dostum, yard\u0131ma ihtiyac\u0131n var m\u0131?"
    m_Metadata:
      m_Items: []
  - m_Id: 212790794457088
    m_Localized: "Anla\u015F\u0131ld\u0131! Melody'yi g\xF6rd\xFCn m\xFC?"
    m_Metadata:
      m_Items: []
  - m_Id: 212804430139392
    m_Localized: "Hay\u0131r, te\u015Fekk\xFCrler. Ba\u015Fka bir yoldan gidece\u011Fim."
    m_Metadata:
      m_Items: []
  - m_Id: 212817994518528
    m_Localized: "Hay\u0131r, bulamad\u0131m. Umar\u0131m onu bulursun."
    m_Metadata:
      m_Items: []
  - m_Id: 12743165760442368
    m_Localized: "Ye\u015Fil-mavi katlarda sadece 1 atlay\u0131\u015F hakk\u0131n\u0131z
      var!"
    m_Metadata:
      m_Items: []
  - m_Id: 17323643087122432
    m_Localized: "Tanr\u0131"
    m_Metadata:
      m_Items: []

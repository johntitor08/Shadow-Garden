  m_TableData:
  - m_Id: 953087889408
    m_Localized: "\u041D\u0435\u0432\u043E\u043A\u0441\u0430 - \u0433\u043B\u0430\u0432\u043D\u044B\u0439
      \u0433\u0435\u0440\u043E\u0439.\n\u041E\u043D \u0443\u043C\u0440\u0435\u0442
      \u0432 \u0441\u0430\u043C\u043E\u043C \u043A\u043E\u043D\u0446\u0435.\n\u042D\u0442\u043E
      \u0432\u0441\u0435 \u0435\u0433\u043E \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 953926750208
    m_Localized: "\u042F \u0434\u0443\u043C\u0430\u044E, \u0442\u044B \u043F\u0440\u0438\u043D\u044F\u043B
      \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0435 \u0440\u0435\u0448\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 952349691904
    m_Localized: "\u041F\u0440\u0438\u0445\u043E\u0434\u0438 \u043F\u043E\u0441\u043B\u0435
      \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u0441\u043E\u0431\u0435\u0440\u0435\u0448\u044C
      19 \u0437\u0432\u0435\u0437\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 951544385536
    m_Localized: "(\u042F \u043D\u0435 \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u044E
      ^^)"
    m_Metadata:
      m_Items: []
  - m_Id: 950709719040
    m_Localized: "\u0422\u044B \u0445\u043E\u0447\u0435\u0448\u044C \u0443\u0437\u043D\u0430\u0442\u044C
      \u043A\u043E\u043D\u0435\u0446 \u0438\u0441\u0442\u043E\u0440\u0438\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 949833109504
    m_Localized: "\u042F \u043D\u0435 \u043C\u043E\u0433\u0443 \u043F\u043E\u0432\u0435\u0440\u0438\u0442\u044C,
      \u0447\u0442\u043E \u0442\u044B \u043D\u0430\u0448\u0435\u043B \u044D\u0442\u043E
      \u043C\u0435\u0441\u0442\u043E.\n\u042F \u0434\u0430\u043C \u0442\u0435\u0431\u0435
      \u043F\u0440\u0430\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 949061357568
    m_Localized: "\u0422\u043E\u043B\u044C\u043A\u043E \u0440\u0435\u0436\u0438\u043C
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 948222496768
    m_Localized: "\u0422\u043E\u043B\u044C\u043A\u043E \u0440\u0435\u0436\u0438\u043C
      \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 947861786624
    m_Localized: "\u041D\u0435 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 946595106816
    m_Localized: "\u041E\u0447\u0435\u043D\u044C \u0445\u043E\u0440\u043E\u0448\u0430\u044F
      \u0438\u0434\u0435\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 945785606144
    m_Localized: "\u041A\u043E\u0440\u043E\u0447\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 945001271296
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0442\u0430\u043A
      \u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 944204353536
    m_Localized: "\u0414\u043E\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 943403241472
    m_Localized: "\u0421\u0442\u0438\u043B\u044C \u043F\u0430\u0440\u043A\u0443\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 942597935104
    m_Localized: "\u0421\u0442\u0438\u043B\u044C \u044D\u043A\u0448\u0435\u043D\u0430
      \u0438 \u0432\u0440\u0430\u0433\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 941826183168
    m_Localized: "\u0421\u0442\u0438\u043B\u044C \u0433\u043E\u043B\u043E\u0432\u043E\u043B\u043E\u043C\u043E\u043A
      \u0438 \u043B\u0430\u0431\u0438\u0440\u0438\u043D\u0442\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 941087985664
    m_Localized: "\u0414\u0440\u0443\u0433\u043E\u0435..."
    m_Metadata:
      m_Items: []
  - m_Id: 940312039424
    m_Localized: "\u0411\u043E\u043B\u0435\u0435 \u043B\u0435\u0433\u043A\u0438\u0439
      \u0433\u0435\u0439\u043C\u043F\u043B\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 939510927360
    m_Localized: "\u0411\u0435\u0433\u043B\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 938835644416
    m_Localized: "\u041A\u0430\u0447\u0435\u0441\u0442\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 938034532352
    m_Localized: "\u041C\u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u043B\u044E\u0431\u043E\u043F\u044B\u0442\u043D\u043E,
      \u043A\u0430\u043A \u0438\u0434\u0435\u0442 \u043F\u0440\u043E\u0446\u0435\u0441\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 937229225984
    m_Localized: "\u042D\u0442\u043E \u043C\u043E\u0433\u043B\u043E \u0431\u044B\u0442\u044C
      \u043B\u0443\u0447\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 935614418944
    m_Localized: "\u041C\u043D\u0435 \u044D\u0442\u043E \u0432 \u0446\u0435\u043B\u043E\u043C
      \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u043B\u043E\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 32668848128
    m_Localized: "\u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 31930650624
    m_Localized: "\u0421\u043A\u0443\u0447\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 31158898688
    m_Localized: "\u0423\u0432\u043B\u0435\u043A\u0430\u0442\u0435\u043B\u044C\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 30454255616
    m_Localized: "\u041D\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 29057552384
    m_Localized: "\u0414\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 29753806848
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 28172554240
    m_Localized: "\u0427\u0442\u043E \u0442\u044B \u0434\u0443\u043C\u0430\u0435\u0448\u044C
      \u043E \u0441\u044E\u0436\u0435\u0442\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 27472105472
    m_Localized: "\u041C\u043E\u0436\u0435\u0448\u044C \u043E\u0446\u0435\u043D\u0438\u0442\u044C
      \u044D\u0442\u0443 \u0438\u0433\u0440\u0443 \u043F\u043E \u0434\u0435\u0441\u044F\u0442\u0438\u0431\u0430\u043B\u043B\u044C\u043D\u043E\u0439
      \u0448\u043A\u0430\u043B\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 26700353536
    m_Localized: "\u042D\u0442\u043E \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u0442\u044C..."
    m_Metadata:
      m_Items: []
  - m_Id: 26096373760
    m_Localized: "\u041A\u0430\u043A\u043E\u0433\u043E \u0442\u0438\u043F\u0430 \u0443\u0440\u043E\u0432\u043D\u0438
      \u0442\u0435\u0431\u0435 \u043D\u0440\u0430\u0432\u044F\u0442\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 25353981952
    m_Localized: "\u041D\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 24619978752
    m_Localized: "\u0414\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 23881781248
    m_Localized: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E \u0437\u0430 \u043E\u0431\u0440\u0430\u0442\u043D\u0443\u044E
      \u0441\u0432\u044F\u0437\u044C :)"
    m_Metadata:
      m_Items: []
  - m_Id: 23143583744
    m_Localized: "\u0422\u044B \u0445\u043E\u0447\u0435\u0448\u044C \u0443\u0440\u043E\u0432\u043D\u0438
      \u0441 \u0440\u0435\u0436\u0438\u043C\u043E\u043C \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438
      \u0438\u043B\u0438 \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u044C\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 22396997632
    m_Localized: "\u0427\u0442\u043E \u0442\u044B \u0434\u0443\u043C\u0430\u0435\u0448\u044C
      \u043E \u0434\u043B\u0438\u043D\u0435 \u0443\u0440\u043E\u0432\u043D\u0435\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 21499416576
    m_Localized: "\u042F \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u044E\u0441\u044C
      \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u0438\u0433\u0440\u0443 \u0442\u0430\u043A\u043E\u0439,
      \u043A\u0430\u043A \u0442\u044B \u0445\u043E\u0447\u0435\u0448\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 18747953152
    m_Localized: "\u0427\u0442\u043E \u0442\u044B \u043E\u0436\u0438\u0434\u0430\u0435\u0448\u044C
      \u043E\u0442 \u044D\u0442\u043E\u0439 \u0438\u0433\u0440\u044B?"
    m_Metadata:
      m_Items: []
  - m_Id: 15757414400
    m_Localized: "\u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u043C\u043D\u0435
      \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u043B\u0430\u0441\u044C
      \u043B\u0438 \u0442\u0435\u0431\u0435 \u044D\u0442\u0430 \u0438\u0433\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 7779848192
    m_Localized: "\u042D\u0439, \u0442\u044B \u0445\u043E\u0447\u0435\u0448\u044C
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 10887827456
    m_Localized: "\u0422\u044B \u0443\u0432\u0435\u0440\u0435\u043D?"
    m_Metadata:
      m_Items: []
  - m_Id: 13618319360
    m_Localized: "\u0425\u043E\u0440\u043E\u0448\u043E, \u0440\u0430\u0434, \u0435\u0441\u043B\u0438
      \u044F \u0442\u0435\u0431\u044F \u043E\u0431\u0440\u0430\u0434\u043E\u0432\u0430\u043B."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []

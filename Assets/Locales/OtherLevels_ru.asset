  - m_Id: 182841708544
    m_Localized: "\u042D\u0442\u0430\u043F 5"
    m_Metadata:
      m_Items: []
  - m_Id: 188285915136
    m_Localized: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 'S' \u0438\u043B\u0438
      \u0441\u0442\u0440\u0435\u043B\u043A\u0443 \u0432\u043D\u0438\u0437, \u0447\u0442\u043E\u0431\u044B
      \u0443\u043F\u0430\u0441\u0442\u044C \u0432\u043D\u0438\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 189829419008
    m_Localized: "\u0413\u0434\u0435 \u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 191406477312
    m_Localized: "\u042F \u0437\u0430\u0432\u043E\u044E\u044E \u043C\u0438\u0440!"
    m_Metadata:
      m_Items: []
  - m_Id: 212817994518528
    m_Localized: "\u041D\u0435\u0442, \u043D\u0435 \u0432\u0438\u0434\u0435\u043B.
      \u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0432\u044B \u0435\u0435 \u043D\u0430\u0439\u0434\u0435\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 212804430139392
    m_Localized: "\u041D\u0435\u0442, \u0441\u043F\u0430\u0441\u0438\u0431\u043E.
      \u042F \u043F\u043E\u0439\u0434\u0443 \u0434\u0440\u0443\u0433\u0438\u043C
      \u043F\u0443\u0442\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 212790794457088
    m_Localized: "\u041F\u043E\u043D\u044F\u043B! \u0412\u044B \u0432\u0438\u0434\u0435\u043B\u0438
      \u041C\u0435\u043B\u043E\u0434\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 212763799916544
    m_Localized: "\u042D\u0439, \u043F\u0430\u0440\u0435\u043D\u044C, \u0442\u0435\u0431\u0435
      \u043D\u0443\u0436\u043D\u0430 \u043F\u043E\u043C\u043E\u0449\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 12743165760442368
    m_Localized: "\u041D\u0430 \u0437\u0435\u043B\u0435\u043D\u043E-\u0433\u043E\u043B\u0443\u0431\u044B\u0445
      \u044D\u0442\u0430\u0436\u0430\u0445 \u043C\u043E\u0436\u043D\u043E \u0441\u043E\u0432\u0435\u0440\u0448\u0438\u0442\u044C
      \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u0434\u0438\u043D \u043F\u0440\u044B\u0436\u043E\u043A!"
    m_Metadata:
      m_Items: []
  - m_Id: 17323676566056960
    m_Localized: "\u0425\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C \u0411\u043E\u0433\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 17323643087122432
    m_Localized: "\u0411\u043E\u0433"
    m_Metadata:
      m_Items: []

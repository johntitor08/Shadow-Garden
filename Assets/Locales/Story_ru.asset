  m_TableData:
  - m_Id: 12989173760
    m_Localized: "\u0414\u0430\u0432\u043D\u044B\u043C-\u0434\u0430\u0432\u043D\u043E
      \u0432 \u044D\u0442\u0438\u0445 \u043A\u0440\u0430\u044F\u0445 \u0436\u0438\u043B\u0430
      \u043D\u0438\u043D\u0434\u0437\u044F. \u0415\u0435 \u0437\u0430\u0432\u0435\u0442\u043D\u043E\u0439
      \u043C\u0435\u0447\u0442\u043E\u0439 \u0431\u044B\u043B\u043E \u0441\u0442\u0430\u0442\u044C
      \u0430\u0432\u0430\u0442\u0430\u0440\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 1756857953095680
    m_Localized: "\u0415\u0433\u043E \u043C\u0430\u0441\u0442\u0435\u0440 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B
      \u0435\u043C\u0443 \u043E \u0428\u0430\u0440\u0435 \u0414\u0440\u0430\u043A\u043E\u043D\u0430.
      \u0427\u0435\u043B\u043E\u0432\u0435\u043A, \u043F\u043E\u043B\u0443\u0447\u0438\u0432\u0448\u0438\u0439
      \u0428\u0430\u0440 \u0414\u0440\u0430\u043A\u043E\u043D\u0430, \u043E\u0432\u043B\u0430\u0434\u0435\u0435\u0442
      4 \u0441\u0442\u0438\u0445\u0438\u044F\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1757440957157376
    m_Localized: "\u041C\u0430\u0441\u0442\u0435\u0440 \u0441\u043A\u0430\u0437\u0430\u043B
      \u0435\u0439: \"\u0415\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
      \u0441\u043F\u043E\u0441\u043E\u0431 \u0441\u0442\u0430\u0442\u044C \u0410\u0432\u0430\u0442\u0430\u0440\u043E\u043C
      - \u043E\u0431\u043B\u0430\u0434\u0430\u0442\u044C \u0428\u0430\u0440\u043E\u043C
      \u0414\u0440\u0430\u043A\u043E\u043D\u0430.\""
    m_Metadata:
      m_Items: []
  - m_Id: 1757444224520192
    m_Localized: "\u042D\u0442\u043E\u0442 \u043D\u0438\u043D\u0434\u0437\u044F \u0440\u0435\u0448\u0438\u043B
      \u043D\u0430\u0439\u0442\u0438 \u0428\u0430\u0440 \u0414\u0440\u0430\u043A\u043E\u043D\u0430
      \u0438 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B\u0441\u044F \u0432
      \u043F\u0440\u0438\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1758137907875840
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u044F\u0437\u044B\u043A"
